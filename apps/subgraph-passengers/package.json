{
  "name": "@flightops/subgraph-passengers",
  "version": "0.0.0",
  "private": true,
  "description": "Passengers subgraph: passengers, bookings, boarding passes.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --conditions=@flightops/source src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@flightops/config": "workspace:*",
    "@flightops/logger": "workspace:*",
    "@flightops/service-kit": "workspace:*"
  }
}
