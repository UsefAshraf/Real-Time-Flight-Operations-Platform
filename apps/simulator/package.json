{
  "name": "@flightops/simulator",
  "version": "0.0.0",
  "private": true,
  "description": "Flight simulator: drives flights through the state machine and injects disruptions.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --conditions=@flightops/source src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --testTimeout=60000 --hookTimeout=180000"
  },
  "dependencies": {
    "@flightops/config": "workspace:*",
    "@flightops/db": "workspace:*",
    "@flightops/domain": "workspace:*",
    "@flightops/flights-core": "workspace:*",
    "@flightops/logger": "workspace:*",
    "@flightops/service-kit": "workspace:*"
  },
  "devDependencies": {
    "@flightops/testing": "workspace:*"
  }
}
