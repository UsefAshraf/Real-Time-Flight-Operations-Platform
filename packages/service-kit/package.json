{
  "name": "@flightops/service-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Health endpoints, readiness checks and graceful shutdown for every service.",
  "type": "module",
  "exports": {
    ".": {
      "@flightops/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@flightops/logger": "workspace:*"
  }
}
