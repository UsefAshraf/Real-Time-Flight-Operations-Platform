# Copy to .env and adjust. Every value shown is the built-in default for local development,
# so nothing is required to run against `pnpm infra:up`.

NODE_ENV=development
LOG_LEVEL=info

# Postgres / Redis (infra/docker-compose/compose.yaml)
DATABASE_URL=postgres://flightops:flightops@localhost:5433/flightops
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6380

# Seed (pnpm db:seed)
SEED_RANDOM_SEED=42
SEED_DAYS=3
SEED_START_OFFSET_DAYS=-1
SEED_FLIGHTS_PER_DAY=2000
SEED_PASSENGERS=50000
SEED_BOOKINGS_MIN=20
SEED_BOOKINGS_MAX=60

# Simulator (apps/simulator)
SIM_TICK_MS=1000
SIM_SPEED=1
SIM_DELAYS_PER_MIN=0.3
SIM_GATE_CHANGES_PER_MIN=0.2
SIM_CANCELLATIONS_PER_MIN=0.01
SIM_DIVERSIONS_PER_MIN=0.002

# Outbox relay (apps/outbox-relay)
OUTBOX_BATCH_SIZE=200
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_RETENTION_HOURS=72
OUTBOX_STREAM_MAX_LENGTH=100000
